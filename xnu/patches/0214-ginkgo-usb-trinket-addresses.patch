+/*
+ * Read-only: what the apps SMMU (SMMUv2 at 0x0c600000 on sm6125) does with
+ * the controller's DMA stream -- the event buffer and every packet go
+ * through it. A translating context bank set up by ABL would turn our
+ * physical addresses into faults.
+ */
+static void
+usb_smmu_report(uint32_t stream)
+{
+	vm_offset_t g = ml_io_map(0x0c600000, 0x80000);
+	if (g == 0) {
+		return;
+	}
+	uint32_t cr0 = usb_rd(g, 0), idr0 = usb_rd(g, 0x20), idr1 = usb_rd(g, 0x24);
+	uint32_t smrs = idr0 & 0xff, page = (idr1 >> 31) ? 0x10000 : 0x1000;
+	uint32_t pages = 1u << (((idr1 >> 28) & 7) + 1);
+	bool found = false;
+	for (uint32_t i = 0; i < smrs && i < 128; i++) {
+		uint32_t smr = usb_rd(g, 0x800 + 4 * i), id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+		if (!(smr >> 31) || ((stream ^ id) & ~mask) != 0) {
+			continue;
+		}
+		uint32_t s2cr = usb_rd(g, 0xc00 + 4 * i), type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		found = true;
+		printf("SWEET USB: SMMU stream %#x: SMR[%u] %#x S2CR %#x (%s, cb %u)\n", stream, i, smr, s2cr,
+		    type == 0 ? "translate" : type == 1 ? "bypass" : "fault", cb);
+		if (type == 0 && (uint64_t)(pages + cb + 1) * page <= 0x80000) {
+			vm_offset_t c = g + (pages + cb) * page;
+			printf("SWEET USB: SMMU cb %u: sctlr %#x (%s) ttbr0 %#x%08x fsr %#x\n", cb,
+			    usb_rd(c, 0), (usb_rd(c, 0) & 1) ? "TRANSLATING" : "off", usb_rd(c, 0x24),
+			    usb_rd(c, 0x20), usb_rd(c, 0x58));
+		}
+	}
+	if (!found) {
+		printf("SWEET USB: SMMU stream %#x unmatched (cr0 %#x: %s)\n", stream, cr0,
+		    (cr0 >> 10) & 1 ? "fault" : "bypass");
+	}
+}
