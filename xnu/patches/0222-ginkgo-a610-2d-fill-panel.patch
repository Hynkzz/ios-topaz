+
+	printf("SWEET A610: step 13: the 2D engine fills 16x64 pixels of the scratch area\n");
+	{
+		volatile uint32_t *test = (volatile uint32_t *)(core_memory + TEST_OFFSET);
+		volatile uint32_t *page = (volatile uint32_t *)(core_memory + CORE_SCRATCH_OFFSET);
+		const uint32_t expect = 0xffff8000;     /* B 00 G 80 R ff A ff, read as a little-endian word */
+
+		for (unsigned i = 0; i < 16 * 64; i++) {
+			test[i] = 0;
+		}
+		to_memory((vm_offset_t)test, 16 * 64 * 4);
+		ring_2d_begin();
+		ring_fill(core_phys + TEST_OFFSET, 64, 16, 0, 64, 255, 128, 0);
+		ring_2d_end(0x0c0c0c0c);
+		if (!ring_run("fill a small picture")) {
+			return -13;
+		}
+		to_memory(core_memory + CORE_SCRATCH_OFFSET, 64);
+		to_memory((vm_offset_t)test, 16 * 64 * 4);
+		printf("SWEET A610: flush words %#x %#x; pixels: first %#x, middle %#x, last %#x (told %#x)\n",
+		    page[8], page[4], test[0], test[16 * 32 + 8], test[16 * 64 - 1], expect);
+		smmu_faults("after the fill");
+		if (test[0] != expect || test[16 * 32 + 8] != expect || test[16 * 64 - 1] != expect) {
+			printf("SWEET A610: the picture is not what the 2D engine was told to draw\n");
+			return -13;
+		}
+		printf("SWEET A610: THE 2D ENGINE DRAWS\n");
+	}
+	if (steps < 14) {
+		return 13;
+	}
+
+	printf("SWEET A610: step 14: three bands into the panel's framebuffer (%#lx)\n", FB_PHYS);
+	{
+		const uint32_t third = FILL_HEIGHT / 3;
+		static vm_offset_t fb;
+
+		ring_2d_begin();
+		ring_fill(FB_PHYS, FILL_ROW, FILL_ROW / 4, 0, third, 255, 128, 0);              /* orange */
+		ring_fill(FB_PHYS, FILL_ROW, FILL_ROW / 4, third, 2 * third, 255, 255, 255);    /* white */
+		ring_fill(FB_PHYS, FILL_ROW, FILL_ROW / 4, 2 * third, FILL_HEIGHT, 0, 128, 255); /* blue */
+		ring_2d_end(0x0e0e0e0e);
+		if (!ring_run("fill the panel")) {
+			return -14;
+		}
+		smmu_faults("after the panel");
+		if (fb == 0) {
+			fb = ml_io_map(FB_PHYS, FB_ROW * FB_HEIGHT);
+		}
+		printf("SWEET A610: framebuffer reads: row 10 %#x, row 1170 %#x, row 2300 %#x\n",
+		    rd(fb + 10 * FB_ROW + 2000), rd(fb + 1170 * FB_ROW + 2000), rd(fb + 2300 * FB_ROW + 2000));
+		printf("SWEET A610: A PICTURE DRAWN BY THE GPU: orange, white, blue from the top\n");
+	}
+	return 14;
 }
 
