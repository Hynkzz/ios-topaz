+/*
+ * Read-only look at the apps SMMU (SMMUv2 at 0x0c600000, sm6125) for one
+ * stream: which stream-match entries take it and what their context bank
+ * does (bypass / fault / translate with which tables).
+ */
+static void
+sweet_smmu_report(uint32_t stream)
+{
+	volatile uint32_t *g = (volatile uint32_t *)ml_io_map(0x0c600000, 0x80000);
+	if (g == NULL) {
+		return;
+	}
+	uint32_t cr0 = g[0], idr0 = g[0x20 / 4], idr1 = g[0x24 / 4];
+	uint32_t smrs = idr0 & 0xff, page = (idr1 >> 31) ? 0x10000 : 0x1000;
+	uint32_t pages = 1u << (((idr1 >> 28) & 7) + 1);
+	IOLog("SWEET SMMU: cr0 %#x idr0 %#x idr1 %#x (%u SMRs, unmatched %s)\n", cr0, idr0, idr1, smrs,
+	    (cr0 >> 10) & 1 ? "fault" : "bypass");
+	for (uint32_t i = 0; i < smrs && i < 128; i++) {
+		uint32_t smr = g[(0x800 + 4 * i) / 4], id = smr & 0x7fff, mask = (smr >> 16) & 0x7fff;
+		if (!(smr >> 31) || ((stream ^ id) & ~mask) != 0) {
+			continue;
+		}
+		uint32_t s2cr = g[(0xc00 + 4 * i) / 4], type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		IOLog("SWEET SMMU: stream %#x: SMR[%u] %#x S2CR %#x (%s, cb %u)\n", stream, i, smr, s2cr,
+		    type == 0 ? "translate" : type == 1 ? "bypass" : "fault", cb);
+		if (type == 0 && (uint64_t)(pages + cb + 1) * page <= 0x80000) {
+			volatile uint32_t *c = g + (pages + cb) * page / 4;
+			IOLog("SWEET SMMU: cb %u: sctlr %#x tcr %#x ttbr0 %#x%08x fsr %#x far %#x%08x\n", cb,
+			    c[0], c[0x30 / 4], c[0x24 / 4], c[0x20 / 4], c[0x58 / 4], c[0x64 / 4], c[0x60 / 4]);
+		}
+	}
+}
