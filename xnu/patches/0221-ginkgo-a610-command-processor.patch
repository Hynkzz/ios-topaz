+static void
+to_memory(vm_offset_t start, vm_size_t size)
+{
+	for (vm_offset_t line = start & ~(vm_offset_t)63; line < start + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+	}
+	__builtin_arm_dsb(0xf);
+}
+
+static void
+put64(vm_offset_t reg, uint64_t value)
+{
+	wr(reg, (uint32_t)value);
+	wr(reg + 4, (uint32_t)(value >> 32));
+}
+
+static uint32_t
+odd_parity(uint32_t v)
+{
+	return 0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28)) & 1;
+}
+
+static void
+ring(uint32_t word)
+{
+	((uint32_t *)core_memory)[ring_at] = word;
+	ring_at = (ring_at + 1) % RING_WORDS;
+}
+
+/* PM4 type 7 packet header */
+static void
+ring_command(uint32_t command, uint32_t words)
+{
+	ring(7u << 28 | words | odd_parity(words) << 15 | command << 16 | odd_parity(command) << 23);
+}
+
+static void
+smmu_faults(const char *when)
+{
+	printf("SWEET A610: SMMU %s: sGFSR %#x sGFSYNR0 %#x sGFSYNR1 %#x; context 4 FSR %#x FAR %#x:%#x FSYNR0 %#x\n", when,
+	    rd(smmu + 0x48), rd(smmu + 0x50), rd(smmu + 0x54), rd(smmu + 0xc000 + 0x58), rd(smmu + 0xc000 + 0x64),
+	    rd(smmu + 0xc000 + 0x60), rd(smmu + 0xc000 + 0x68));
+}
+
+/* What was put into the ring out to memory and to the core, then up to 2 s for it to be read and idle. */
+static bool
+ring_run(const char *what)
+{
+	uint32_t taken = ~0u, status = ~0u;
+
+	printf("SWEET A610: the core is to %s: ring up to word %u\n", what, ring_at);
+	if (ring_at >= ring_sent) {
+		to_memory(core_memory + 4 * ring_sent, 4 * (ring_at - ring_sent));
+	} else {
+		to_memory(core_memory + 4 * ring_sent, 4 * (RING_WORDS - ring_sent));
+		to_memory(core_memory, 4 * ring_at);
+	}
+	ring_sent = ring_at;
+	wr(gpu + CP_RB_WPTR, ring_at);
+	for (int i = 0; i < 20000 && (taken != ring_at || (status & ~1u)); i++) {
+		delay_for_interval(100, NSEC_PER_USEC);
+		taken = rd(gpu + CP_RB_RPTR);
+		status = rd(gpu + RBBM_STATUS);
+	}
+	if (taken == ring_at && !(status & ~1u) && rd(gpu + CP_HW_FAULT) == 0) {
+		printf("SWEET A610: done (ring read up to %u, status %#x)\n", taken, status);
+		return true;
+	}
+	printf("SWEET A610: NOT done: ring read %u of %u, status %#x, int %#x, CP fault %#x int %#x protect %#x\n",
+	    taken, ring_at, status, rd(gpu + RBBM_INT_0_STATUS), rd(gpu + CP_HW_FAULT), rd(gpu + CP_INTERRUPT_STATUS),
+	    rd(gpu + CP_PROTECT_STATUS));
+	smmu_faults("now");
+	return false;
+}
