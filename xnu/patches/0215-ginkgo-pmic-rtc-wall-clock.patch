--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -9,6 +9,9 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int sweet_rtc_read(uint32_t *secs);
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -18,8 +21,19 @@ public:
 	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
 	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
 	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	long getGMTTimeOfDay(void) APPLE_KEXT_OVERRIDE;
+	void setGMTTimeOfDay(long secs) APPLE_KEXT_OVERRIDE;
 };
 
+/*
+ * Wall clock from the PMIC RTC (sweet_keys.c), which nobody sets: time is
+ * RTC + offset. The offset comes from boot-arg sweetrtc_off=<seconds>;
+ * when userland sets the time, the matching offset is logged so it can go
+ * into the boot-args (no NVRAM to keep it in) and is used until reboot.
+ */
+static bool rtc_have_off;
+static long rtc_off;
+
 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
 bool
@@ -30,6 +44,8 @@ SweetPlatformExpert::start(IOService *provider)
 		return false;
 	}
 	registerService();
+	/* IOKitInitializeTime waits up to 30 s for an RTC driver to publish this. */
+	publishResource("IORTC");
 	IOLog("SWEET: platform expert registered\n");
 	return true;
 }
@@ -74,6 +90,36 @@ SweetPlatformExpert::processTopLevel(IORegistryEntry *root)
 	}
 }
 
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint32_t raw;
+	if (sweet_rtc_read(&raw) != 0) {
+		IOLog("SWEET RTC: PMIC RTC not readable\n");
+		return 0;
+	}
+	if (!rtc_have_off) {
+		int off = 0;
+		(void)PE_parse_boot_argn("sweetrtc_off", &off, sizeof(off));
+		rtc_off = off;
+		rtc_have_off = true;
+		IOLog("SWEET RTC: raw %u + sweetrtc_off %ld\n", raw, rtc_off);
+	}
+	return (long)raw + rtc_off;
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	uint32_t raw;
+	if (sweet_rtc_read(&raw) != 0) {
+		return;
+	}
+	rtc_off = secs - (long)raw;
+	rtc_have_off = true;
+	IOLog("SWEET RTC: time set to %ld; keep it with boot-arg sweetrtc_off=%ld\n", secs, rtc_off);
+}
