+/*
+ * PM6125 RTC (USID 0, peripheral 0x60, pm6125.dtsi qcom,pm6125_rtc_rw@6000):
+ * a 32-bit seconds counter, RTC_CTRL 0x46 bit 7 = enabled, RTC_READ 0x48-0x4b
+ * least significant byte first (Linux qpnp-rtc.c). The dtsi has
+ * qcom,qpnp-rtc-write = <0>: the counter is never set, Android adds an
+ * offset it keeps in userspace. Read only, like the keys. Read twice so a
+ * carry between the byte reads is caught. Thread context; may be called
+ * before sweet_keys_init.
+ */
+int
+sweet_rtc_read(uint32_t *secs)
+{
+	static uint16_t rtc_apid = KEYS_NO_APID;
+	if (!keys_map()) {
+		return -1;
+	}
+	if (rtc_apid == KEYS_NO_APID) {
+		uint32_t version = keys_rd(keys_core, 0), count = keys_rd(keys_core, 4) & 0x7ffu;
+		if (version < 0x50000000u || version >= 0x70000000u || count == 0 || count > 512) {
+			return -1;
+		}
+		rtc_apid = keys_find_apid(0x060, count);
+	}
+	uint8_t ctrl = 0;
+	if (!keys_read(rtc_apid, 0x6046, &ctrl) || !(ctrl & 0x80u)) {
+		return -1;
+	}
+	for (int attempt = 0; attempt < 3; attempt++) {
+		uint8_t b[4], again;
+		bool ok = true;
+		for (int i = 0; i < 4 && ok; i++) {
+			ok = keys_read(rtc_apid, (uint16_t)(0x6048 + i), &b[i]);
+		}
+		if (!ok || !keys_read(rtc_apid, 0x6048, &again)) {
+			return -1;
+		}
+		if (again == b[0]) {
+			*secs = (uint32_t)b[0] | ((uint32_t)b[1] << 8) | ((uint32_t)b[2] << 16) | ((uint32_t)b[3] << 24);
+			return 0;
+		}
+	}
+	return -1;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
