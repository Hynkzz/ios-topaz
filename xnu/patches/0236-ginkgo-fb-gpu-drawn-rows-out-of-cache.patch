 #include <kern/clock.h>
 #include <sys/proc.h>
 
+extern "C" void sweet_dcache_flush(vm_offset_t addr, unsigned length);  /* osfmk/arm/caches.c (0111): dc civac */
+
+/*
+ * ginkgo: rows of a surface the GPU drew, about to be read here, out of this processor's caches
+ * first. SweetGPU (0232) no longer pushes every buffer out of them when the GPU is done: what was
+ * cached of the surface's memory before (an earlier frame, read here; zeroes, when it was made)
+ * was copied to the panel instead of what the GPU had drawn -- a scroll that never settled.
+ */
+static void
+sweet_gpu_drawn_rows(SweetSurface *s, uintptr_t first, uint64_t length)
+{
+	if (s->gpuBumps != 0 && length != 0) {
+		sweet_dcache_flush((vm_offset_t)first, (unsigned)length);
+	}
+}
