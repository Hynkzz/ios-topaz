+
+/* The answers to msm's GET_PARAM that this GPU has (msm_drm.h numbers); false: none. */
+bool
+sweet_a610_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01:                              /* GPU_ID: none, the chip ID says it */
+	case 0x08:                              /* PP_PGTABLE */
+	case 0x09:                              /* FAULTS */
+	case 0x0a:                              /* SUSPENDS */
+	case 0x11:                              /* RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x02:                              /* GMEM_SIZE */
+		*value = GMEM_SIZE;
+		return true;
+	case 0x03:                              /* CHIP_ID */
+		*value = GPU_CHIP_ID_A610;
+		return true;
+	case 0x04:                              /* MAX_FREQ: the core runs from the crystal */
+		*value = 19200000;
+		return true;
+	case 0x05:                              /* TIMESTAMP */
+		*value = mach_absolute_time();
+		return true;
+	case 0x06:                              /* GMEM_BASE: where step 11 puts UCHE_GMEM_RANGE (willow: 0 hung Mesa) */
+		*value = 0x00100000;
+		return true;
+	case 0x07:                              /* PRIORITIES */
+		*value = 1;
+		return true;
+	case 0x10:                              /* HIGHEST_BANK_BIT: a6xx_calc_ubwc_config for the A610 */
+		*value = 13;
+		return true;
+	case 0x12:                              /* UBWC_SWIZZLE */
+		*value = 7;
+		return true;
+	case 0x13:                              /* MACROTILE_MODE */
+		*value = 0;
+		return true;
+	default:
+		return false;
+	}
+}
+
+uint64_t
+sweet_a610_address(uint64_t size)
+{
+	uint64_t address = 0;
+
+	lck_mtx_lock(&a610_lock);
+	if (kept) {
+		address = kept_address(size);
+	}
+	lck_mtx_unlock(&a610_lock);
+	return address;
+}
+
+void
+sweet_a610_address_free(uint64_t address, uint64_t size)
+{
+	lck_mtx_lock(&a610_lock);
+	if (kept) {
+		kept_address_free(address, size);
+	}
+	lck_mtx_unlock(&a610_lock);
+}
+
+/* One 4K page at an address of the core's; after a buffer's last, sweet_a610_mapped(). */
+bool
+sweet_a610_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	bool good = false;
+
+	lck_mtx_lock(&a610_lock);
+	if (kept && address >= GPU_ADDRESSES_START && address < GPU_ADDRESSES_START + GPU_ADDRESSES_SIZE) {
+		good = space_map_as(address, phys, PTE_CORE | (read_only ? PTE_READ_ONLY : 0));
+	}
+	lck_mtx_unlock(&a610_lock);
+	return good;
+}
+
+void
+sweet_a610_mapped(void)
+{
+	lck_mtx_lock(&a610_lock);
+	if (kept) {
+		space_commit();
+	}
+	lck_mtx_unlock(&a610_lock);
+}
+
+void
+sweet_a610_unmap(uint64_t address, uint64_t size)
+{
+	lck_mtx_lock(&a610_lock);
+	if (kept && address >= GPU_ADDRESSES_START && address + size <= GPU_ADDRESSES_START + GPU_ADDRESSES_SIZE) {
+		kept_unmap(address, size);
+	}
+	lck_mtx_unlock(&a610_lock);
+}
+
+/* Command buffers for the core to run, in order: each an address and a count of words. 0: not taken. */
+uint32_t
+sweet_a610_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t fence;
+
+	lck_mtx_lock(&a610_lock);
+	fence = kept_submit(addresses, words, count);
+	lck_mtx_unlock(&a610_lock);
+	return fence;
+}
+
+bool
+sweet_a610_done(uint32_t fence)
+{
+	return kept && kept_done(fence);
+}
+
+uint32_t
+sweet_a610_last(void)
+{
+	return kept_fence;
+}
+
+/* Up to `microseconds` for submission `fence`; false: not done by then. */
+bool
+sweet_a610_wait(uint32_t fence, uint32_t microseconds)
+{
+	for (uint32_t waited = 0; !sweet_a610_done(fence); waited += 100) {
+		if (waited >= microseconds) {
+			return false;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	return true;
+}
+
+void
+sweet_a610_report(const char *why)
+{
+	lck_mtx_lock(&a610_lock);
+	if (kept) {
+		kept_report(why);
+	}
+	lck_mtx_unlock(&a610_lock);
+}
