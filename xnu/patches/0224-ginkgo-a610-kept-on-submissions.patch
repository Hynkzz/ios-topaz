+/* The panel's framebuffer at TARGET_ADDRESS for the core, once. */
+static bool
+fb_map(void)
+{
+	static bool mapped;
+
+	for (uint32_t offset = 0; !mapped && offset < FB_ROW * FB_HEIGHT; offset += 4096) {
+		if (!space_map(TARGET_ADDRESS + offset, FB_PHYS + offset)) {
+			return false;
+		}
+	}
+	if (!mapped) {
+		space_commit();
