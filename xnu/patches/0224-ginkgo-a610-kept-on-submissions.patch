+/*
+ * Page tables of ours for SMMU context 0 (willow-hackios redwood_a610.c
+ * space_*): three levels of 4K tables, each at the start of a kernel page.
+ */
+static struct {
+	uint32_t count;
+	uint64_t *table[SPACE_TABLES];
+	uint64_t phys[SPACE_TABLES];
+} space;
+
+static uint64_t *
+space_table(uint64_t *entry)
+{
+	vm_offset_t page;
+
+	if (entry != NULL && (*entry & 1)) {
+		for (uint32_t i = 0; i < space.count; i++) {
+			if (space.phys[i] == (*entry & PTE_ADDRESS)) {
+				return space.table[i];
+			}
+		}
+		return NULL;
+	}
+	if (space.count == SPACE_TABLES || kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	space.table[space.count] = (uint64_t *)page;
+	space.phys[space.count++] = kvtophys(page);
+	if (entry != NULL) {
+		*entry = kvtophys(page) | PTE_TABLE;
+	}
+	return (uint64_t *)page;
+}
+
+/* One 4K page of the core's addresses to a physical page. */
+static bool
+space_map_as(uint64_t address, uint64_t phys, uint64_t attributes)
+{
+	uint64_t *level2, *level3;
+
+	if (address >> 39 || (space.count == 0 && space_table(NULL) == NULL)) {
+		return false;
+	}
+	if ((level2 = space_table(&space.table[0][address >> 30 & 0x1ff])) == NULL ||
+	    (level3 = space_table(&level2[address >> 21 & 0x1ff])) == NULL) {
+		return false;
+	}
+	level3[address >> 12 & 0x1ff] = attributes == 0 ? 0 : (phys & PTE_ADDRESS) | attributes | PTE_PAGE;
+	return true;
+}
+
+static bool
+space_map(uint64_t address, uint64_t phys)
+{
+	return space_map_as(address, phys, PTE_CORE);
+}
+
+/* Kernel memory (`size` bytes of pages) at an address of the core's. */
+static bool
+space_block(uint64_t address, vm_offset_t memory, uint32_t size)
+{
+	for (uint32_t offset = 0; offset < size; offset += 4096) {
+		if (!space_map(address + offset, kvtophys(memory + offset))) {
+			printf("SWEET A610: no room for the tables at %#llx\n", address + offset);
+			return false;
+		}
+	}
+	return true;
+}
+
+/* The tables out to memory, the TLB of context 0 invalidated. */
+static void
+space_commit(void)
+{
+	vm_offset_t cb = smmu + 0x8000;
+
+	for (uint32_t i = 0; i < space.count; i++) {
+		to_memory((vm_offset_t)space.table[i], 4096);
+	}
+	wr(cb + SMMU_CB_TLBIASID, 0);
+	wr(cb + SMMU_CB_TLBSYNC, 1);
+	for (int i = 0; i < 1000 && (rd(cb + SMMU_CB_TLBSTATUS) & 1); i++) {
+		delay_for_interval(10, NSEC_PER_USEC);
+	}
+}
+
+/* Context 0 with our tables and the GPU's stream through it; what the SMMU took is checked. */
+static bool
+space_on(void)
+{
+	vm_offset_t cb = smmu + 0x8000;
+	uint64_t root = space.phys[0];
+
+	wr(cb + 0x00, 0);
+	wr(smmu + 0x1800, 1);                   /* CBA2R 0: 64-bit */
+	wr(smmu + 0x1000, SMMU_CBAR_STAGE_1);   /* CBAR 0 */
+	wr(cb + SMMU_CB_TCR2, SMMU_TCR2);
+	wr(cb + SMMU_CB_TCR, SMMU_TCR_39_BITS);
+	put64(cb + SMMU_CB_TTBR0, root);
+	put64(cb + SMMU_CB_TTBR1, 0);
+	wr(cb + SMMU_CB_MAIR0, SMMU_MAIR0);
+	wr(cb + SMMU_CB_MAIR1, 0);
+	wr(cb + SMMU_CB_FSR, SMMU_FSR_ALL);
+	space_commit();
+	wr(cb + 0x00, SMMU_SCTLR_ON);
+	wr(smmu + 0xc00, 0);                    /* S2CR 0: translate, context 0 */
+	wr(smmu + 0x800, SMMU_GPU_SMR);
+	__builtin_arm_dsb(0xf);
+	printf("SWEET A610: SMMU context 0 CBAR %#x CBA2R %#x SCTLR %#x TCR %#x TCR2 %#x TTBR0 %#x:%#x (ours %#llx); SMR0 %#x S2CR0 %#x\n",
+	    rd(smmu + 0x1000), rd(smmu + 0x1800), rd(cb), rd(cb + SMMU_CB_TCR), rd(cb + SMMU_CB_TCR2),
+	    rd(cb + SMMU_CB_TTBR0 + 4), rd(cb + SMMU_CB_TTBR0), root, rd(smmu + 0x800), rd(smmu + 0xc00));
+	if (rd(smmu + 0x800) != SMMU_GPU_SMR || (rd(smmu + 0xc00) & 0x300ff) != 0 || !(rd(cb) & 1) ||
+	    rd(cb + SMMU_CB_TTBR0) != (uint32_t)root || rd(cb + SMMU_CB_TTBR0 + 4) != (uint32_t)(root >> 32)) {
+		printf("SWEET A610: the SMMU did NOT take our tables\n");
+		return false;
+	}
+	printf("SWEET A610: the GPU's stream goes through our tables (%u of them)\n", space.count);
+	return true;
+}
+
+/* What context 0 recorded of a request it could not serve. */
+static bool
+space_faulted(const char *when)
+{
+	vm_offset_t cb = smmu + 0x8000;
+
+	if (!translated || (rd(cb + SMMU_CB_FSR) & SMMU_FSR_ALL) == 0) {
+		return false;
+	}
+	printf("SWEET A610: THE SMMU REFUSED the core %s: FSR %#x FAR %#x:%#x FSYNR0 %#x\n", when, rd(cb + SMMU_CB_FSR),
+	    rd(cb + SMMU_CB_FAR + 4), rd(cb + SMMU_CB_FAR), rd(cb + SMMU_CB_FSYNR0));
+	return true;
+}
