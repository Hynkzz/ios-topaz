+/* Step 15: steps 1-12 through our tables, the GPU kept on, the self-test. */
+static int
+a610_keep(void)
+{
+	int done;
+
+	if (kept) {
+		return kept_selftest() ? 15 : -15;
+	}
+	want_translated = true;
+	if ((done = a610_run(12)) != 12) {
+		return done;
+	}
+	if (!translated || !zap_loaded) {
+		printf("SWEET A610: not kept: the core must take commands out of secure mode through our tables "
+		    "(a first step 11 without sweetgpu_smmu=1 this boot left it untranslated)\n");
+		return -15;
+	}
+	bzero((void *)(core_memory + CORE_SCRATCH_OFFSET + KEPT_FENCE_AT), 4);
+	to_memory(core_memory + CORE_SCRATCH_OFFSET, 4096);
+	gpu_free[0].start = GPU_ADDRESSES_START;
+	gpu_free[0].size = GPU_ADDRESSES_SIZE;
+	gpu_free_count = 1;
+	kept = true;
+	printf("SWEET A610: THE GPU STAYS ON (19.2 MHz) for the system to draw with\n");
+	return kept_selftest() ? 15 : -15;
+}
