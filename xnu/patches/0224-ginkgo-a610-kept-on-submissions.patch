+/*
+ * ---- the GPU kept on (step 15) ----
+ *
+ * willow-hackios redwood_a610.c "the GPU kept on" and redwood_adreno.c's
+ * address allocator. A submission is what Linux's a6xx_submit puts in the
+ * ring: the colour and depth caches invalidated, the program's command
+ * buffers (CP_INDIRECT_BUFFER), then its number written to the scratch page
+ * once the caches are in memory. The callers of the sweet_a610_* functions
+ * need not hold anything: each takes a610_lock.
+ */
+static struct {
+	uint64_t start, size;
+} gpu_free[256];                        /* the addresses not in use, in order */
+static unsigned gpu_free_count;
+static uint64_t gpu_lost;
+
+static uint64_t
+gpu_span(uint64_t size)
+{
+	return (size + GPU_ADDRESS_GRANULE - 1) & ~(GPU_ADDRESS_GRANULE - 1);
+}
+
+static uint64_t
+kept_address(uint64_t size)
+{
+	size = gpu_span(size);
+	for (unsigned i = 0; i < gpu_free_count; i++) {
+		if (gpu_free[i].size >= size) {
+			uint64_t address = gpu_free[i].start;
+
+			gpu_free[i].start += size;
+			gpu_free[i].size -= size;
+			if (gpu_free[i].size == 0) {
+				memmove(&gpu_free[i], &gpu_free[i + 1], (--gpu_free_count - i) * sizeof(gpu_free[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+static void
+kept_address_free(uint64_t address, uint64_t size)
+{
+	unsigned at;
+
+	size = gpu_span(size);
+	for (at = 0; at < gpu_free_count && gpu_free[at].start < address; at++) {
+	}
+	if (at > 0 && gpu_free[at - 1].start + gpu_free[at - 1].size == address) {
+		gpu_free[at - 1].size += size;
+		if (at < gpu_free_count && address + size == gpu_free[at].start) {
+			gpu_free[at - 1].size += gpu_free[at].size;
+			memmove(&gpu_free[at], &gpu_free[at + 1], (--gpu_free_count - at) * sizeof(gpu_free[0]));
+		}
+	} else if (at < gpu_free_count && address + size == gpu_free[at].start) {
+		gpu_free[at].start = address;
+		gpu_free[at].size += size;
+	} else if (gpu_free_count < sizeof(gpu_free) / sizeof(gpu_free[0])) {
+		memmove(&gpu_free[at + 1], &gpu_free[at], (gpu_free_count++ - at) * sizeof(gpu_free[0]));
+		gpu_free[at].start = address;
+		gpu_free[at].size = size;
+	} else {
+		gpu_lost += size;               /* no room to remember the hole: never handed out again */
+	}
+}
+
+static void
+kept_unmap(uint64_t address, uint64_t size)
+{
+	for (uint64_t offset = 0; offset < size; offset += 4096) {
+		(void)space_map_as(address + offset, 0, 0);
+	}
+	space_commit();
+}
+
+static bool
+kept_done(uint32_t fence)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(core_memory + CORE_SCRATCH_OFFSET + KEPT_FENCE_AT);
+
+	to_memory((vm_offset_t)word, 4);
+	return (int32_t)(*word - fence) >= 0;
+}
+
+static uint32_t
+kept_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t wanted = 24 + 4 * count, room = 0;
+	uint64_t fence_at = core_address + CORE_SCRATCH_OFFSET + KEPT_FENCE_AT;
+
+	if (!kept) {
+		return 0;
+	}
+	for (int i = 0; i < 20000; i++) {
+		room = (rd(gpu + CP_RB_RPTR) + RING_WORDS - ring_at - 1) % RING_WORDS;
+		if (room >= wanted) {
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	if (room < wanted) {
+		return 0;
+	}
+	if (++kept_fence == 0) {
+		kept_fence = 1;
+	}
+	ring_command(CP_EVENT_WRITE, 1);
+	ring(EVENT_INVALIDATE_DEPTH);
+	ring_command(CP_EVENT_WRITE, 1);
+	ring(EVENT_INVALIDATE_COLOR);
+	for (uint32_t i = 0; i < count; i++) {
+		ring_command(CP_INDIRECT_BUFFER, 3);
+		ring((uint32_t)addresses[i]);
+		ring((uint32_t)(addresses[i] >> 32));
+		ring(words[i]);
+	}
+	ring_command(CP_WAIT_FOR_IDLE, 0);
+	ring_register(CP_SCRATCH_REG2, kept_fence);
+	ring_command(CP_EVENT_WRITE, 4);
+	ring(EVENT_CACHE_FLUSH);
+	ring((uint32_t)fence_at);
+	ring((uint32_t)(fence_at >> 32));
+	ring(kept_fence);
+	ring_send();
+	return kept_fence;
+}
+
+static void
+kept_report(const char *why)
+{
+	printf("SWEET A610: %s: submission %u is the last, the core has done %u; ring read up to %u, written up to %u; "
+	    "status %#x, interrupts %#x; CP fault %#x, interrupts %#x, protection %#x; IB1 %#x:%#x (%u to go), IB2 %#x:%#x (%u to go)\n",
+	    why, kept_fence, *(volatile uint32_t *)(core_memory + CORE_SCRATCH_OFFSET + KEPT_FENCE_AT), rd(gpu + CP_RB_RPTR),
+	    ring_at, rd(gpu + RBBM_STATUS), rd(gpu + RBBM_INT_0_STATUS), rd(gpu + CP_HW_FAULT), rd(gpu + CP_INTERRUPT_STATUS),
+	    rd(gpu + CP_PROTECT_STATUS), rd(gpu + CP_IB1_BASE + 4), rd(gpu + CP_IB1_BASE), rd(gpu + CP_IB1_REM_SIZE),
+	    rd(gpu + CP_IB2_BASE + 4), rd(gpu + CP_IB2_BASE), rd(gpu + CP_IB2_REM_SIZE));
+	(void)space_faulted(why);
+}
+
+/* Pages of ours, kernel memory, at an address from the allocator: a buffer as a service will make one. */
+static uint64_t
+kept_buffer(vm_offset_t *memory, uint32_t size)
+{
+	uint64_t address;
+
+	if (kmem_alloc(kernel_map, memory, round_page(size), KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
+	    KERN_SUCCESS) {
+		return 0;
+	}
+	if ((address = kept_address(size)) == 0) {
+		kmem_free(kernel_map, *memory, round_page(size));
+		return 0;
+	}
+	for (uint32_t offset = 0; offset < size; offset += 4096) {
+		if (!space_map(address + offset, kvtophys(*memory + offset))) {
+			return 0;
+		}
+	}
+	space_commit();
+	return address;
+}
+
+static void
+kept_buffer_free(vm_offset_t memory, uint64_t address, uint32_t size)
+{
+	kept_unmap(address, size);
+	kept_address_free(address, size);
+	kmem_free(kernel_map, memory, round_page(size));
+}
