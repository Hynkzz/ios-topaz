+/* Step 15: steps 1-12 through our tables, the GPU kept on, the self-test. */
+static int
+a610_keep(void)
+{
+	int done;
+
+	if (kept) {
+		return kept_selftest() ? 15 : -15;
+	}
+	want_translated = true;
+	if ((done = a610_run(12)) != 12) {
+		return done;
+	}
+	if (!translated || !zap_loaded) {
+		printf("SWEET A610: not kept: the core must take commands out of secure mode through our tables "
+		    "(a first step 11 without sweetgpu_smmu=1 this boot left it untranslated)\n");
+		return -15;
