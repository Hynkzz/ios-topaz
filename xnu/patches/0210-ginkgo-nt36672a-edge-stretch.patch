 		}
 		id--;
 		mask |= 1u << id;
-		/* chip range -> 1080x2340 panel pixels, + 30 into SweetHID's canvas (touch_ft8719) */
-		x[id] = (int)(px * (FT_PANEL_W - 1u) / nvt_max_x);
-		y[id] = (int)(py * (FT_PANEL_H - 1u) / nvt_max_y) + 30;
+		/* chip range -> panel pixels -> canvas, less SweetHID's own offsets */
+		uint32_t cx = nvt_edge(px * (FT_PANEL_W - 1u) / nvt_max_x, FT_PANEL_W,
+		    (NVT_CANVAS_W - FT_PANEL_W) / 2u & ~3u, NVT_CANVAS_W);
+		uint32_t cy = nvt_edge(py * (FT_PANEL_H - 1u) / nvt_max_y, FT_PANEL_H,
+		    (NVT_CANVAS_H - FT_PANEL_H) / 2u, NVT_CANVAS_H);
+		x[id] = (int)cx - (int)NVT_OFF_X;
+		y[id] = (int)cy - (int)NVT_OFF_Y;
