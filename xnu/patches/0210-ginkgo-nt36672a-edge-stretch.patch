--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -1445,6 +1445,31 @@ nvt_identify(void)
 	return ENODEV;
 }
 
+/*
+ * Panel pixel -> SweetHID's 1125x2436 canvas, where the 1080x2340 panel sits at
+ * +20,+48: 1:1 inside, but the outer NVT_EDGE pixels stretched onto the canvas
+ * border, so a swipe from the glass edge starts at iOS's screen edge (home
+ * indicator, Control Center, back swipe) instead of 48 px inside it.
+ */
+#define NVT_EDGE          48u
+#define NVT_CANVAS_W      1125u
+#define NVT_CANVAS_H      2436u
+#define NVT_OFF_X         20u     /* SweetHID fOffX: (1125 - 1080) / 2 & ~3 */
+#define NVT_OFF_Y         18u     /* SweetHID fOffY: (2436 - 2400) / 2 */
+
+static uint32_t
+nvt_edge(uint32_t v, uint32_t n, uint32_t off, uint32_t canvas)
+{
+	if (v < NVT_EDGE) {
+		return v * (off + NVT_EDGE) / NVT_EDGE;
+	}
+	if (v > n - 1u - NVT_EDGE) {
+		uint32_t from = n - 1u - NVT_EDGE + off, to = canvas - 1u;
+		return from + (v - (n - 1u - NVT_EDGE)) * (to - from) / NVT_EDGE;
+	}
+	return v + off;
+}
+
 static int
 touch_nvt_frame(void)
 {
