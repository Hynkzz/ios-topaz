+bool
+SweetBattery::readPmicWord(unsigned sid, unsigned address, uint16_t *value)
+{
+	uint16_t previous = 0;
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t lo, hi;
+		if (sweet_pmic_read(sid, address, &lo) ||
+		    sweet_pmic_read(sid, address + 1, &hi)) {
+			return false;
+		}
+		uint16_t next = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+		if (attempt && next == previous) {
+			*value = next;
+			return true;
+		}
+		previous = next;
+	}
+	return false;
+}
