+/*
+ * ginkgo: PMI632 on USID 2 (pmi632.dtsi), the same QG/SMB5 register layout
+ * as the PM6150 path below: QG 0x4800 (LAST_ADC_V 0xc0, LAST_ADC_I 0xc2,
+ * qg-defs.h V_RAW_TO_UV 194.637 uV, I_RAW_TO_UA 152.588 uA for the 5 A
+ * subtype), CHGR status 0x1006/0x1007/0x100d, DCDC power path 0x110b,
+ * USBIN_INT_RT_STS 0x1310 bit 4. Read only. Android's QG computes SOC in
+ * software from a battery profile; here the voltage curve is used on an
+ * open-circuit estimate (ESR ~150 mOhm for the load), smoothed, and only
+ * allowed to fall on battery and rise on the charger.
+ */
+bool
+SweetBattery::pollGinkgo(void)
+{
+	uint8_t type, present, usb = 0, path = 0, charger = 0, error = 0, temperature = 0, subtype;
+	uint16_t rawVoltage, rawCurrent;
+	if (sweet_pmic_read(2, 0x4804, &type) || type != 0x0d ||
+	    sweet_pmic_read(2, 0x4808, &present) || !(present & 1u) ||
+	    !readPmicWord(2, 0x48c0, &rawVoltage) || rawVoltage == 0x8000) {
+		return false;
+	}
+	unsigned mv = (unsigned)(((uint64_t)rawVoltage * 194637u) / 1000000u);
+	if (mv < 2800 || mv > 4600) {
+		return false;
+	}
+	bool chgOk = !sweet_pmic_read(2, 0x1310, &usb) &&
+	    !sweet_pmic_read(2, 0x110b, &path) &&
+	    !sweet_pmic_read(2, 0x1006, &charger) &&
+	    !sweet_pmic_read(2, 0x1007, &error) &&
+	    !sweet_pmic_read(2, 0x100d, &temperature);
+	bool external = chgOk && (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(error & 2u) && !(temperature & 0x0cu);
+	bool full = external && state == 5 && !(error & 2u);
+	int ma = 0;
+	bool currentValid = !sweet_pmic_read(2, 0x4805, &subtype) &&
+	    (subtype == 3 || subtype == 4) && readPmicWord(2, 0x48c2, &rawCurrent) &&
+	    rawCurrent != 0x8000;
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* Linux: negative=charging; IOPMPowerSource: positive=charging, mA. */
+		ma = (int)(-((int64_t)signedRaw * (subtype == 3 ? 152588 : 305176)) / 1000000);
+	}
+	/* Open-circuit estimate: add back the drop under load, remove the rise while charging. */
+	int ocv = (int)mv - ma * 150 / 1000;
+	if (ocv < 2800) {
+		ocv = 2800;
+	} else if (ocv > 4600) {
+		ocv = 4600;
+	}
+	int raw = (int)estimatePercent((unsigned)ocv) * 100;
+	if (fSmooth < 0) {
+		fSmooth = raw;
+	} else {
+		int next = fSmooth + (raw - fSmooth) / 4;
+		if ((!external && next < fSmooth) || (external && next > fSmooth)) {
+			fSmooth = next;
+		}
+	}
+	unsigned percent = full ? 100u : (unsigned)((fSmooth + 50) / 100);
+	if (percent < 1) {
+		percent = 1;
+	} else if (percent > 100) {
+		percent = 100;
+	}
+	publish(percent, mv, ma, external, capable, charging, full, true, currentValid);
+	static unsigned logs;
+	if (logs++ % 30 == 0) {
+		IOLog("SWEET BATTERY: ginkgo %u%% %umV ocv %dmV %dmA usb=%#x path=%#x chg=%#x external=%d charging=%d\n",
+		    percent, mv, ocv, ma, usb, path, charger, external, charging);
+	}
+	return true;
+}
