+	printf("SWEET A610: step 9: the zap shader\n");
+	if (zap_loaded) {
+		printf("SWEET A610: already in\n");
+		return 9;
+	}
+	{
+		uint64_t phys = 0, answer = ~0ull;
+		uint32_t size = 0, segments;
+		const uint8_t *header = gpufw_file("a610_zap.mdt", &phys, &size);
+		int32_t result;
+
+		if (header == NULL) {
+			printf("SWEET A610: no a610_zap.mdt in the payload (mkpayload.py --gpufw)\n");
+			return -9;
+		}
+		/* a 32-bit ELF: segment count at 44, the table at 52, 32 bytes each */
+		segments = size >= 52 + 2 * 32 ? (uint32_t)(header[44] | header[45] << 8) : 0;
+		if (memcmp(header, "\177ELF\1", 5) != 0 || segments < 2 || 52 + 32 * segments > size) {
+			printf("SWEET A610: a610_zap.mdt is not such a header\n");
+			return -9;
+		}
+		printf("SWEET A610: zap header %u bytes, %u segments, at %#llx\n", size, segments, phys);
+		/* TrustZone reads memory, not this processor's cache */
+		for (vm_offset_t line = (vm_offset_t)header & ~63ul; line < (vm_offset_t)header + size; line += 64) {
+			__asm__ volatile ("dc civac, %0" : : "r" (line) : "memory");
+		}
+		__builtin_arm_dsb(0xf);
+		result = scm3("to take the zap shader's signature", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE,
+		    SCM_VALUE_AND_BUFFER, PAS_GPU, phys, 0, &answer);
+		if (result != 0 || answer != 0) {
+			printf("SWEET A610: TrustZone does not take it: %d, %#llx\n", result, answer);
+			return -9;
+		}
+		printf("SWEET A610: TRUSTZONE ACCEPTS THE ZAP SHADER'S SIGNATURE\n");
+		if (!zap_load(header, segments)) {
+			return -9;
+		}
+		zap_loaded = true;
+	}
+	return 9;
 }
 
