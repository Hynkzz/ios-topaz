+static int32_t
+scm(const char *what, uint64_t function, uint64_t first, uint64_t *answer)
+{
+	return scm3(what, function, SCM_ONE_VALUE, first, 0, 0, answer);
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return p[0] | p[1] << 8 | p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* A file of the payload's GPUFirmware container: its physical address and size. */
+static const uint8_t *
+gpufw_file(const char *name, uint64_t *phys, uint32_t *size)
+{
+	void *pa = NULL;
+	int total = 0;
+	const uint8_t *blob;
+	uint32_t count;
+
+	if (IODTGetLoaderInfo("GPUFirmware", &pa, &total) != 0 || pa == NULL || total < 16) {
+		return NULL;
+	}
+	blob = (const uint8_t *)ml_static_ptovirt((vm_offset_t)pa);
+	if (blob == NULL || memcmp(blob, "SWGPUFW1", 8) != 0) {
+		return NULL;
+	}
+	count = le32(blob + 8);
+	for (uint32_t i = 0; i < count && 12 + 40 * (i + 1) <= (uint32_t)total; i++) {
+		const uint8_t *e = blob + 12 + 40 * i;
+		uint32_t off = le32(e + 32), len = le32(e + 36);
+
+		if (strncmp((const char *)e, name, 32) == 0 && off <= (uint32_t)total && len <= (uint32_t)total - off) {
+			*phys = (uint64_t)(uintptr_t)pa + off;
+			*size = len;
+			return blob + off;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * The rest of qcom_mdt_load once TrustZone has the signature: the one
+ * loadable segment is relocatable, so it goes to gpu_region; TrustZone is
+ * told where first (PAS_MEM_SETUP), the segments are copied from their .b0N
+ * files (zeros past a file up to the segment's memory size), then
+ * PAS_AUTH_AND_RESET.
+ */
+static bool
+zap_load(const uint8_t *header, uint32_t segments)
+{
+	uint32_t low = ~0u, high = 0;
+	bool relocatable = false;
+	uint64_t answer = ~0ull;
+	vm_offset_t region;
+
+	for (uint32_t i = 0; i < segments; i++) {
+		const uint8_t *ph = header + 52 + 32 * i;
+		uint32_t paddr = le32(ph + 12), memsz = le32(ph + 20), flags = le32(ph + 24);
+
+		if (le32(ph) != 1 || memsz == 0 || MDT_TYPE(flags) == MDT_TYPE_HASH) {
+			continue;
+		}
+		relocatable |= (flags & MDT_RELOCATABLE) != 0;
+		low = paddr < low ? paddr : low;
+		high = paddr + memsz > high ? paddr + memsz : high;
+	}
+	high = (high + 0xfff) & ~0xfffu;
+	printf("SWEET A610: zap segments %#x to %#x, %s\n", low, high, relocatable ? "relocatable" : "NOT relocatable");
+	if (low >= high || !relocatable || high - low > ZAP_REGION_SIZE) {
+		printf("SWEET A610: zap shader does not fit gpu_region (%#lx at %#lx)\n", ZAP_REGION_SIZE, ZAP_REGION_PHYS);
+		return false;
+	}
+	if (scm3("where the zap shader goes", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_GPU,
+	    ZAP_REGION_PHYS, high - low, &answer) != 0 || answer != 0) {
+		printf("SWEET A610: TrustZone refuses the zap region (%#llx)\n", answer);
+		return false;
+	}
+	region = ml_io_map(ZAP_REGION_PHYS, ZAP_REGION_SIZE);
+	for (uint32_t i = 0; i < segments; i++) {
+		const uint8_t *ph = header + 52 + 32 * i;
+		uint32_t paddr = le32(ph + 12), filesz = le32(ph + 16), memsz = le32(ph + 20), flags = le32(ph + 24);
+		vm_offset_t to = region + (paddr - low);
+		char name[24];
+		uint64_t phys = 0;
+		uint32_t size = 0;
+		const uint8_t *data;
+
+		if (le32(ph) != 1 || memsz == 0 || MDT_TYPE(flags) == MDT_TYPE_HASH) {
+			continue;
+		}
+		snprintf(name, sizeof(name), "a610_zap.b%02u", i);
+		data = gpufw_file(name, &phys, &size);
+		if (data == NULL || size < filesz) {
+			printf("SWEET A610: no %s of %u bytes in GPUFirmware\n", name, filesz);
+			return false;
+		}
+		for (uint32_t at = 0; at < memsz; at += 4) {
+			uint32_t word = 0;
+
+			for (uint32_t b = 0; b < 4; b++) {
+				word |= at + b < filesz ? (uint32_t)data[at + b] << (8 * b) : 0;
+			}
+			*(volatile uint32_t *)(to + at) = word;
+		}
+		__builtin_arm_dsb(0xf);
+		printf("SWEET A610: segment %u (%s, %u bytes, %u in memory) at %#lx: %#x %#x\n", i, name, filesz, memsz,
+		    ZAP_REGION_PHYS + (paddr - low), rd(to), rd(to + 4));
+	}
+	answer = ~0ull;
+	if (scm("to authenticate and start the zap shader", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, PAS_GPU,
+	    &answer) != 0 || answer != 0) {
+		printf("SWEET A610: TrustZone does not start the zap shader (%#llx)\n", answer);
+		return false;
+	}
+	printf("SWEET A610: THE ZAP SHADER IS IN\n");
+	return true;
+}
