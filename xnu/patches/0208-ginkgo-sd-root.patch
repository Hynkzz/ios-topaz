+/* An application command: CMD55 to the card at rca, then ACMDidx. */
+static int
+sd_acmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t *resp)
+{
+	int error = emmc_cmd(55, su.rca << 16, EM_R48 | EM_CRC | EM_IDX, NULL);
+	return error ? error : emmc_cmd(idx, arg, flags, resp);
+}
+
+static int
+sd_init_card(void)
+{
+	uint32_t ver = ufs_rd(EM_VERSION), resp = 0, ocr = 0;
+	if (ver == 0 || ver == 0xffffffff) {
+		printf("SWEET SD: host registers read 0x%x\n", ver);
+		return ENXIO;
+	}
+	uint32_t base = (ufs_rd(EM_CAPS) >> 8) & 0xff;
+	ufs_wr(EM_INT_EN, 0xffff00ff & ~0x100u);
+	ufs_wr(EM_SIG_EN, 0);
+	ufs_wr(EM_INT_STAT, 0xffffffff);
+	/* 3.3 V bus power, 3.3 V signalling (host control 2 bit 3 clear), 1-bit bus. */
+	ufs_wr(EM_HOST_CTRL2, ufs_rd(EM_HOST_CTRL2) & ~(1u << 19));
+	uint32_t hc = ufs_rd(EM_HOSTCTL);
+	if (((hc >> 8) & 0x0f) != 0x0f) {
+		ufs_wr(EM_HOSTCTL, (hc & ~0xff00u) | (0x0fu << 8));
+		emmc_pwrctl_ack();
+	}
+	ufs_wr(EM_HOSTCTL, ufs_rd(EM_HOSTCTL) & ~((1u << 5) | (1u << 2) | (1u << 1) | (3u << 3)));
+	ufs_wr(EM_CLOCK, (ufs_rd(EM_CLOCK) & ~(0xffu << 16)) | (0x0eu << 16));
+	(void)base;
+	emmc_set_clock(24);             /* 400 kHz from 19.2 MHz: the shim puts SDCC2 on XO */
+
+	su.rca = 0;
+	(void)emmc_cmd(0, 0, 0, NULL);
+	delay(2000);
+	if (emmc_cmd(8, 0x1aa, EM_R48 | EM_CRC | EM_IDX, &resp) || (resp & 0xfff) != 0x1aa) {
+		printf("SWEET SD: no SD 2.0 card (CMD8 resp 0x%x): supplies off or no card?\n", resp);
+		return ENXIO;
+	}
+	/* Up to ~2 s: CMD55 / ACMD41 failures are counted for the log. */
+	uint32_t e55 = 0, e41 = 0, last = 0, st = 0;
+	for (int i = 0; i < 2000 && !(ocr & (1u << 31)); i++) {
+		int error = emmc_cmd(55, 0, EM_R48 | EM_CRC | EM_IDX, NULL);
+		if (error) {
+			e55++;
+			st = ufs_rd(EM_INT_STAT);
+		} else if ((error = emmc_cmd(41, 0x40ff8000, EM_R48, &ocr))) {   /* HCS, 2.7-3.6 V */
+			e41++;
+			st = ufs_rd(EM_INT_STAT);
+			ocr = 0;
+		} else {
+			last = ocr;
+		}
+		if (!(ocr & (1u << 31))) {
+			delay(1000);
+		}
+	}
+	if (!(ocr & (1u << 31)) || !(ocr & (1u << 30))) {
+		printf("SWEET SD: card not ready or not SDHC/SDXC (ocr 0x%x, last answer 0x%x, "
+		    "CMD55 errors %u, ACMD41 errors %u, int 0x%x, clock 0x%x, present 0x%x)\n",
+		    ocr, last, e55, e41, st, ufs_rd(EM_CLOCK), ufs_rd(EM_PRESENT));
+		return ENXIO;
+	}
+	if (emmc_cmd(2, 0, EM_R136 | EM_CRC, NULL) ||
+	    emmc_cmd(3, 0, EM_R48 | EM_CRC | EM_IDX, &resp)) {
+		printf("SWEET SD: identification failed\n");
+		return EIO;
+	}
+	su.rca = resp >> 16;
+	if (emmc_cmd(7, su.rca << 16, EM_R48B | EM_CRC | EM_IDX, NULL)) {
+		printf("SWEET SD: select failed (rca 0x%x)\n", su.rca);
+		return EIO;
+	}
+	/* 4-bit bus (ACMD6 arg 2), then the data clock. */
+	if (sd_acmd(6, 2, EM_R48 | EM_CRC | EM_IDX, &resp) == 0) {
+		ufs_wr(EM_HOSTCTL, ufs_rd(EM_HOSTCTL) | (1u << 1));
+	}
+	emmc_set_clock(su.emmc_div);
+	(void)emmc_cmd(13, su.rca << 16, EM_R48 | EM_CRC | EM_IDX, &resp);
+	printf("SWEET SD: host 0x%x ocr 0x%x rca 0x%x state %u hostctl 0x%x clock 0x%x (div %u)\n",
+	    ver >> 16, ocr, su.rca, (resp >> 9) & 0xf, ufs_rd(EM_HOSTCTL), ufs_rd(EM_CLOCK), su.emmc_div);
+	return ((resp >> 9) & 0xf) == 4 ? 0 : EIO;
+}
