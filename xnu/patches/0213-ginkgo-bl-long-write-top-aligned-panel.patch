+/*
+ * Where the 2340-line panel sits in SweetHID's 1125x2436 canvas: top-aligned
+ * (0) unless sweetfb_offy=N, the boot-arg SweetFramebuffer.cpp reads too.
+ * SweetHID itself adds 18 (its 2400-line centring), hence the - 18 below.
+ */
+static int
+touch_offy(void)
+{
+	static int offy = -1;
+	if (offy < 0) {
+		int v = 0;
+		(void)PE_parse_boot_argn("sweetfb_offy", &v, sizeof(v));
+		offy = v >= 0 && v <= 2436 - FT_PANEL_H ? v : 0;
+	}
+	return offy;
+}
