+/*
+ * ginkgo's SweetGPU: the kernel cleans a big buffer out of the CPU's caches before a submission
+ * only when told the CPU may have written it, and invalidates one the GPU wrote only when told the
+ * CPU is about to read it. Below, an idle or unshared buffer never reaches the kernel; so once
+ * the GPU is done with it, the kernel hears of every CPU access (NOSYNC: nothing is waited for).
+ */
+int
+fd_bo_cpu_prep(struct fd_bo *bo, struct fd_pipe *pipe, uint32_t op)
+{
+   int ret = fd_bo_cpu_prep_waited(bo, pipe, op);
+
+   /* (a piece of a heap block has no cpu_prep of its own; the kernel cleans the 4 MB blocks every time) */
+   if (ret == 0 && bo->funcs->cpu_prep && (op & (FD_BO_PREP_READ | FD_BO_PREP_WRITE)))
+      bo->funcs->cpu_prep(bo, pipe, (op & (FD_BO_PREP_READ | FD_BO_PREP_WRITE)) | FD_BO_PREP_NOSYNC);
+   return ret;
+}
+
